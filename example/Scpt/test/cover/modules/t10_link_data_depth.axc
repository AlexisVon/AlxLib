// ====== t10_link_data_depth.axc — Link data shield below the slot level ======
// The whole-slot shield is t8's subject; here the element / nested-key paths:
// every one of them used to reach into the link's data block through a dot chain.
env(["../../bin"]);

link "test_store.so" as ts;

var passed = 0;
var failed = 0;

def assert_eq(a, b, name) {
    if (a == b) { passed = passed + 1; }
    else { failed = failed + 1; $print("FAIL " + name + ": expected " + string(b) + " got " + string(a)); }
}

def assert_true(c, name) {
    if (c) { passed = passed + 1; }
    else { failed = failed + 1; $print("FAIL " + name + ": expected true"); }
}

ts.set("s", "ABCD");
ts.set("v", vec[1, 2, 3]);
ts.set("m", map{"a": "XY", "inner": vec[7, 8, 9]});

// ── vec element / append ──
{
    var k = ""; try { ts.v[0] = 65; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.1 vec element write → TypeError");
}
{
    var k = ""; try { var q = ts.v[0]; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.2 vec element read → TypeError");
}
{
    var k = ""; try { ts.v[null] = 99; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.3 vec append write → TypeError");
}
{
    var k = ""; try { ts.v[1] += 1; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.4 vec compound element → TypeError");
}

// ── map key / nested ──
{
    var k = ""; try { var q = ts.m.a; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.5 map key read → TypeError");
}
{
    var k = ""; try { ts.m.a = "QQ"; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.6 map key write → TypeError");
}
{
    var k = ""; try { ts.m.newk = 1; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.7 map key create → TypeError");
}
{
    var k = ""; try { ts.m.inner[0] = 65; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.8 nested element write → TypeError");
}
{
    var k = ""; try { var q = ts.m.inner[1]; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.9 nested element read → TypeError");
}
{
    var k = ""; try { delete ts.m.a; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.10 nested delete → TypeError");
}
{
    var k = ""; try { delete ts.m.inner[0]; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.10b nested element delete → TypeError");
}
{
    var k = ""; try { delete @("ts.m.inner[1]"); } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.10c @() nested element delete → TypeError");
}

// ── @() and nav forms ──
{
    var k = ""; try { @("ts.v[0]") = 66; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.11 @() element write → TypeError");
}
{
    var k = ""; try { @("ts.m.a") = "ZZ"; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.12 @() nested key write → TypeError");
}
{
    var k = ""; try { var q = @("ts.m.inner[1]"); } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.13 @() nested element read → TypeError");
}
{
    var k = ""; try { var q = .ts.v[0]; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.14 nav element read → TypeError");
}

// ── string element read (a byte value; a link shields it, plain data does not) ──
{
    var k = ""; try { var q = ts.s[0]; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.15 string element read → TypeError");
}
var plain = "ABCD";
assert_eq(plain[0], 65, "10.16 plain string element read follows the byte semantics");

// ── the byte / slice surface the byte-element round opened (the shield holds at any depth) ──
ts.set("sbuf", "ABCD");
ts.set("v4", vec[1, 2, 3, 4]);
{
    var k = ""; try { ts.sbuf[0] = 65; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.23 link string element write → TypeError");
}
{
    var k = ""; try { ts.sbuf[null] = 65; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.24 link string append → TypeError");
}
{
    var k = ""; try { ts.sbuf[0] += 1; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.25 link string element compound → TypeError");
}
{
    var k = ""; try { var q = ts.v4[1, 3]; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.26 link slice read → TypeError");
}
{
    var k = ""; try { ts.v4[1, 3] = [9, 9]; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.27 link slice write → TypeError");
}
{
    var k = ""; try { ts.v4[1, 3] += [9]; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.28 link slice compound → TypeError");
}
{
    var k = ""; try { delete ts.v4[1, 3]; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.29 link slice delete → TypeError");
}
{
    var k = ""; try { ts.sbuf[0, 2] = "XY"; } catch (e) { k = string(e.what); }
    assert_eq(k, "TypeError", "10.30 link string slice write → TypeError");
}
assert_eq(ts.get("sbuf"), "ABCD", "10.31 link string untouched");
assert_eq(ts.get("v4")[null], 4, "10.32 link vec untouched");

// ── must not break: functions and areas ──
assert_eq(ts.get("s"), "ABCD", "10.17 ts.get still works");
assert_eq(ts.sub.echo(42), 42, "10.18 area call still works");
assert_true(ts.has("v"), "10.19 ts.has still works");

// ── host-visible state after all attempts ──
assert_eq(ts.get("v")[null], 3, "10.20 vec untouched");
assert_eq(ts.get("m")[null], 2, "10.21 map untouched");
assert_eq(ts.get("m")["inner"][null], 3, "10.22 nested vec untouched");

$print("--- t10_link_data_depth: " + string(passed) + " passed, " + string(failed) + " failed ---");

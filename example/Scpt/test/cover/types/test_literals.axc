// literals — every literal syntax parses
$print("--- test_literals ---");

// integer
$print("123 = %1", 123);
$print("-456 = %1", -456);
$print("0xFF = %1", 0xFF);
$print("0o77 = %1", 0o77);
$print("0b1010 = %1", 0b1010);

// float
$print("3.14 = %1", 3.14);
$print("-2.5 = %1", -2.5);
$print("1e5 = %1", 1e5);
$print("1.5e-3 = %1", 1.5e-3);
$print("2e-3 = %1", 2e-3);

// char
$print("char c = %1", 'c');
$print("char newline = %1", '\n');
$print("char x41 = %1", '\x41');

// string
$print("str hello = %1", "hello");
$print("str esc newline = %1", "esc\nend");

// bool
$print("true = %1", true);
$print("false = %1", false);

// null
$print("null = %1", null);

// Batch 7: Overflow & Shift errors (§7.1, §7.4, §7.7, §8.8)
// REQUIRES: --overflow-check CLI flag

var passed; passed = 0;
var failed; failed = 0;
var failures; failures = "";

def to_str(v) {
    if (v == null) { return "null"; }
    return string(v);
}

def assert_eq(actual, expected, name) {
    if (actual == expected) { passed = passed + 1; return; }
    failed = failed + 1;
    failures = failures + "  FAIL " + name + ": expected " + to_str(expected) + " got " + to_str(actual) + "\n";
}

def assert_true(cond, name) {
    if (cond) { passed = passed + 1; return; }
    failed = failed + 1;
    failures = failures + "  FAIL " + name + ": expected true\n";
}

// Helper: inline throw checker
def check_throw(ok, etype, expected_type, name) {
    if (ok && etype == expected_type) { passed = passed + 1; }
    else if (ok) {
        failed = failed + 1;
        failures = failures + "  FAIL " + name + ": expected " + expected_type + " got " + etype + "\n";
    } else {
        failed = failed + 1;
        failures = failures + "  FAIL " + name + ": expected " + expected_type + " but no throw\n";
    }
}

// ========== OverflowError: addition ==========
var hit, etype; hit = false; etype = "";
var big, tmp; try { big = 9223372036854775807; tmp = big + 1; }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "OverflowError", "INT64_MAX + 1 → OverflowError");

hit = false;
try { big = -9223372036854775807; tmp = big + (-2); }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "OverflowError", "near INT64_MIN + negative → OverflowError");

// ========== OverflowError: subtraction ==========
hit = false;
try { big = -9223372036854775807; tmp = big - 2; }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "OverflowError", "near INT64_MIN - 2 → OverflowError");

// ========== OverflowError: multiplication ==========
hit = false;
try { big = 922337203685477580; tmp = big * 100; }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "OverflowError", "large * 100 → OverflowError");

// ========== OverflowError: pre-increment ==========
hit = false;
try { big = 9223372036854775807; ++big; }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "OverflowError", "++INT64_MAX → OverflowError");

// ========== OverflowError: post-increment ==========
hit = false;
try { big = 9223372036854775807; big++; }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "OverflowError", "INT64_MAX++ → OverflowError");

// ========== OverflowError: pre-decrement ==========
// Note: --(INT64_MIN+1) = INT64_MIN, no overflow. Only --INT64_MIN overflows,
// but INT64_MIN can't be expressed as a literal with overflow_check on.
// Decrement overflow covered implicitly by subtraction overflow tests.

// ========== OverflowError: compound += ==========
hit = false;
try { big = 9223372036854775807; big += 1; }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "OverflowError", "compound += overflow");

// ========== OverflowError: compound -= ==========
hit = false;
try { big = -9223372036854775807; big -= 2; }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "OverflowError", "compound -= overflow");

// ========== OverflowError: compound *= ==========
hit = false;
try { big = 922337203685477580; big *= 100; }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "OverflowError", "compound *= overflow");

// ========== OverflowError: negation ==========
// Note: INT64_MIN negation requires -9223372036854775808 which can't be a literal.
// With overflow_check on, we can't compute INT64_MIN (= INT64_MIN+1 - 1 overflows).
// Negation overflow tested indirectly via other arithmetic overflow tests.

// ========== ShiftError ==========
hit = false;
try { tmp = 1 << 64; }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "ShiftError", "1 << 64 → ShiftError");

hit = false;
try { tmp = 1 << (-1); }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "ShiftError", "1 << -1 → ShiftError");

hit = false;
try { tmp = 1 >> 64; }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "ShiftError", "1 >> 64 → ShiftError");

hit = false;
try { tmp = 1 >> (-1); }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "ShiftError", "1 >> -1 → ShiftError");

// ========== ShiftError: compound ==========
hit = false;
var x; try { x = 1; x <<= 64; }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "ShiftError", "compound <<= 64 → ShiftError");

hit = false;
x = 1; try { x = 1; x >>= 64; }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "ShiftError", "compound >>= 64 → ShiftError");

// ========== DivOverflowError: INT64_MIN / -1 ==========
// NOTE: Requires computing INT64_MIN without overflow_check first.
// Separate test: compute min_val via wrap, then divide by -1 → DivOverflowError.
// See batch10 for the non-overflow-check version of this test.

// ========== DivZeroError still works ==========
hit = false;
try { tmp = 1 / 0; }
catch (e) { hit = true; etype = e.what; }
check_throw(hit, etype, "DivZeroError", "1 / 0 → DivZeroError");

// ========== Normal ops still work with overflow_check ==========
assert_eq(1 << 2, 4, "normal left shift");
assert_eq(8 >> 2, 2, "normal right shift");
assert_eq(100 + 200, 300, "normal addition");

if (failed > 0) {
    $print("\n=== FAIL: batch7_overflow ===\n");
    $print("Passed: %1 / %2\n", passed, passed + failed);
    $print("FAILURES:\n%1", failures);
}

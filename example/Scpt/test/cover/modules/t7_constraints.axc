// ====== t7_constraints.axc — Constraint Tests ======

var passed = 0;
var failed = 0;

def assert_eq(a, b, name) {
    if (a == b) { passed = passed + 1; }
    else { failed = failed + 1; $print("FAIL " + name + ": expected " + string(b) + " got " + string(a)); }
}
def assert_true(c, name) {
    if (c) { passed = passed + 1; }
    else { failed = failed + 1; $print("FAIL " + name + ": expected true"); }
}

// Set up a root variable for .. tests from imported modules
var root_data = 42;

// ── §8.1 a nav chain does not enter a container — it stops at the variable ──
var mydata = 42;
def test_nav_stop() {
    return .mydata;
}
assert_eq(test_nav_stop(), 42, "8.1 nav stops at variable");

// ── §8.2 cross-module var: read/write ok, create/delete error ──
import "modules/modules/mod_a.axc" as constmod;
assert_eq(constmod.x, 42, "8.2a cross-module read ok");
constmod.x = 7;
assert_eq(constmod.x, 7, "8.2b cross-module write ok");
var caught_create = false;
try { constmod.newkey = 1; } catch (e) { caught_create = true; }
assert_true(caught_create, "8.2c cross-module create -> NameError");
var caught_del = false;
try { delete constmod.x; } catch (e) { caught_del = true; }
assert_true(caught_del, "8.2d cross-module delete -> TypeError");

// ── §8.3 link ns read as variable -> TypeError ──
env(["../../bin"]);
link "base.so" as b;
var caught_ns = false;
try { var x = b; } catch (e) { caught_ns = true; }
assert_true(caught_ns, "8.3 link ns read -> TypeError");

// ── §8.4 .. from imported module targets root ──
// mod_b has no parent_x, so we import and use ..root_data
// This tests the parent entity tree mechanism
import "modules/modules/mod_b.axc" as test_modb;

// mod_b has add function, doesn't use .. itself
// We test via direct cross-module call

// ── Summary ──
$print("--- t7_constraints: " + string(passed) + " passed, " + string(failed) + " failed ---");

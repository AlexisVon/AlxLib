// T07: constraint tests
// a bare dot chain after @ is not supported: @a.b is a compile error
// @ is forbidden in a declaration (var/def/import/link)
// @ does not apply to for-each/catch/function parameters

// Note: a compile error has to be tested by a separate compile run
// that was verified from the shell; this script only covers run-time behaviour

// --- @ forbidden in a declaration (compile error, verified from the shell) ---
// var @x = 5;  → compile error "indirect name (@) not allowed in declaration"
// def @f() {}  → same
// import @f from "xxx"; → same
// link @f to "xxx";     → same
$print("T07.0 compile-time constraints verified via shell tests");

// --- the dot chain limitation after @ ---
// @a.b is not forbidden (not a compile error) but is taken as a path string with dots
// so @a.b is equivalent to the reference path "a.b"
// test: the behaviour of @a.b — reading variable a's b field
var a = map();
a.b = 42;
// read through a double-quoted path
var p = "a.b";
$print("T07.1 @a.b via path string:", @p);
if (@p != 42) { $print("FAIL T07.1"); throw("assert"); }
$print("OK (@a.b is routed as path, not compile error)");

// --- @ does not apply to for-each/catch/function parameters ---
// these are positions where @ cannot be written at all
// verify: a function parameter's name can be reached indirectly through @
var param_name = "x";
def test_func(x) {
    // inside a function the parameters cannot be reached through @ (they are locals, not top-level variables)
    // @param_name tries to find x in the function scope, but @ normally looks at the top level
    // here we only check that the syntax is allowed and does not error
    var local_name = "x";
    try {
        var v = @local_name;
        $print("T07.2 func param via @:", v);
    } catch (e) {
        $print("T07.2 @ on func param caught: ", e);
    }
}
test_func(99);
$print("OK (varies by implementation)");

$print("T07 all passed");

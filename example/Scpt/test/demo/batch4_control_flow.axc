// Batch 4: Control Flow & Functions (lang-guide.md §8, §9)
// Tests if/else, for, for-each, while, switch, break/continue/return, def

var passed; passed = 0;
var failed; failed = 0;
var failures; failures = "";

def to_str(v) {
    if (v == null) { return "null"; }
    return string(v);
}

def assert_eq(actual, expected, name) {
    if (actual == expected) {
        passed = passed + 1;
        return;
    }
    failed = failed + 1;
    failures = failures + "  FAIL " + name + ": expected " + to_str(expected) + " got " + to_str(actual) + "\n";
}

def assert_true(cond, name) {
    if (cond) { passed = passed + 1; return; }
    failed = failed + 1;
    failures = failures + "  FAIL " + name + ": expected true\n";
}

// ========== §8.1 if/else ==========
var x; x = 10;
var if_result; if_result = 0;
if (x > 0) { if_result = 1; }
else if (x < 0) { if_result = -1; }
else { if_result = 0; }
assert_eq(if_result, 1, "if true branch");

x = -5;
if (x > 0) { if_result = 1; }
else if (x < 0) { if_result = -1; }
else { if_result = 0; }
assert_eq(if_result, -1, "if else-if branch");

x = 0;
if (x > 0) { if_result = 1; }
else if (x < 0) { if_result = -1; }
else { if_result = 0; }
assert_eq(if_result, 0, "if else branch");

// ========== §8.2 for ==========
var sum, i; sum = 0;
for (i = 0; i < 5; ++i) { sum = sum + i; }
assert_eq(sum, 10, "for loop sum 0..4");

// Infinite for with break
var infinite_guard; infinite_guard = 0;
for (;;) {
    infinite_guard = infinite_guard + 1;
    if (infinite_guard >= 3) { break; }
}
assert_eq(infinite_guard, 3, "for(;;) infinite loop with break");

// ========== §8.3 for-each ==========
// vec for-each
var arr, v; arr = [10, 20, 30];
sum = 0;
for (v : arr) { sum = sum + v; }
assert_eq(sum, 60, "for-each vec");

// for-each with existing variable
sum = 0;
var elem; elem = 0;
for (elem : arr) { sum = sum + elem; }
assert_eq(sum, 60, "for-each existing var");

// for-each map
var m, kv; m = map{"a": 1, "b": 2};
var keys_sum; keys_sum = 0;
var vals_sum; vals_sum = 0;
for (kv : m) {
    keys_sum = keys_sum + 1;  // count
    vals_sum = vals_sum + kv.value;
}
assert_eq(vals_sum, 3, "for-each map values sum");
assert_eq(keys_sum, 2, "for-each map key count");

// for-each lst
var l; l = lst([1, 2, 3]);
sum = 0;
for (v : l) { sum = sum + v; }
assert_eq(sum, 6, "for-each lst");

// Non-iterable for-each should throw
var non_iter_fail; non_iter_fail = false;
try { for (v : 42) { } } catch (e) { non_iter_fail = true; }
assert_true(non_iter_fail, "for-each int throws");

// ========== §8.4 while ==========
var n; n = 3;
var fact; fact = 1;
while (n > 0) {
    fact = fact * n;
    n = n - 1;
}
assert_eq(fact, 6, "while factorial 3! = 6");

// ========== §8.5 switch ==========
var sw_val; sw_val = 2;
var sw_result; sw_result = "";
switch (sw_val) {
    case 1: sw_result = "one";
    case 2: sw_result = "two";
    case 3: sw_result = "three";
    default: sw_result = "?";
}
assert_eq(sw_result, "two", "switch case match");

// default case
sw_val = 99;
switch (sw_val) {
    case 1: sw_result = "one";
    default: sw_result = "default";
}
assert_eq(sw_result, "default", "switch default");

// No fall-through: each case auto-breaks
sw_val = 1;
var count; count = 0;
switch (sw_val) {
    case 1: count = count + 1;
    case 2: count = count + 1;
    case 3: count = count + 1;
}
assert_eq(count, 1, "switch no fall-through (count=1)");

// ========== §8.6 break/continue/return ==========
// break in for
sum = 0;
for (i = 0; i < 10; ++i) {
    if (i == 5) { break; }
    sum = sum + i;
}
assert_eq(sum, 10, "break in for (0+1+2+3+4)");

// continue in for
var even_sum; even_sum = 0;
for (i = 0; i < 6; ++i) {
    if (i % 2 != 0) { continue; }
    even_sum = even_sum + i;
}
assert_eq(even_sum, 6, "continue in for (0+2+4)");

// continue in while
n = 5;
var odd_count; odd_count = 0;
while (n > 0) {
    n = n - 1;
    if (n % 2 == 0) { continue; }
    odd_count = odd_count + 1;
}
assert_eq(odd_count, 2, "continue in while");

// return
def ret_test() { return 42; }
assert_eq(ret_test(), 42, "return value");

// empty return
def empty_ret() { return; }
assert_eq(empty_ret(), null, "empty return = null");

// ========== §8.7 try/catch/throw ==========
var caught; caught = false;
var err_type; err_type = "";
var err_value; err_value = null;
try {
    throw "test error";
} catch (e) {
    caught = true;
    err_type = e.what;
    err_value = e.info;
}
assert_true(caught, "throw caught");
assert_eq(err_type, "RuntimeError", "throw type = RuntimeError");
assert_eq(err_value, "test error", "throw value");

// Throw non-string
try {
    throw 42;
} catch (e) {
    assert_eq(e.info, "42", "throw int value");
}

// ========== §9.1 print (visual verification only) ==========
// print test (visual): silent
// hello: silent
$print("\n");

// ========== §9.3 def ==========
def add(a, b) { return a + b; }
assert_eq(add(1, 2), 3, "def basic");

// default parameter
def greet(name, greeting) {
    return greeting + " " + name;
}
assert_eq(greet("world", "hello"), "hello world", "def 2-param");

def with_default(a, b) {
    if (b == null) { b = 1; }
    return a + b;
}
assert_eq(with_default(3, 1), 4, "def default param used");

// Missing required param
var arg_err_fail; arg_err_fail = false;
try { add(1); } catch (e) { arg_err_fail = true; }
assert_true(arg_err_fail, "missing arg throws ArgError");

// Closure / nested function
def outer() {
    var ox; ox = 10;
    def inner() { return ox; }
    return inner();
}
assert_eq(outer(), 10, "closure: inner captures outer var");

if (failed > 0) {
    $print("\n=== FAIL: batch4_control_flow ===\n");
    $print("Passed: %1 / %2\n", passed, passed + failed);
    $print("FAILURES:\n%1", failures);
}

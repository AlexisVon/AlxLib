// resolves if the base is cover/modules/ (dir of t6_env.axc), not the file.
// Import failure (env path wrong) throws and exits non-zero.
import "t6_env.axc" as envmod;
// t6_env init ran env() + relative imports + its own asserts (2 passed above)
$print("--- t6b_env_in_module: ok ---");

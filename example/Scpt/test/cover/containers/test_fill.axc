// Test 4.4: Fill syntax

$print("= 4.4 fill syntax tests =\n");

// [0:5] — 5 copies of 0
var f1; f1 = [0:5];
$print("[0:5] type=%1 size=%2\n", type(f1), f1[null]);
$print("[0:5] values: %1 %2 %3 %4 %5\n", f1[0], f1[1], f1[2], f1[3], f1[4]);

// vec[:5] — 5 copies of null
var f2; f2 = [:5];
$print("[:5] type=%1 size=%2\n", type(f2), f2[null]);
$print("[:5][0] is null: %1\n", f2[0] == null);
$print("[:5][4] is null: %1\n", f2[4] == null);

// lst[1:3] — lst with 3 copies of 1
var f3; f3 = lst[1:3];
$print("lst[1:3] type=%1 size=%2\n", type(f3), f3[null]);
$print("lst[1:3][0]=%1, [1]=%2\n", f3[0], f3[-1]);

// [1,2,3:3] — fill suffix
var f4; f4 = [1, 2, 3:3];
$print("[1,2,3:3] size=%1\n", f4[null]);
$print("values: %1 %2 %3 %4 %5\n", f4[0], f4[1], f4[2], f4[3], f4[4]);

// vec fill with explicit prefix
var f5; f5 = vec[1,2,3:3];
$print("vec[1,2,3:3] size=%1\n", f5[null]);
$print("vec fill values: %1 %2 %3 %4 %5\n", f5[0], f5[1], f5[2], f5[3], f5[4]);

// Exceed max_vecfill -> ResourceError
$print("Testing max_vecfill overflow...\n");
try {
    var too_big; too_big = [:20000];
    $print("ERROR: should have thrown ResourceError\n");
} catch (e) {
    $print("correctly caught ResourceError: %1\n", e);
}

$print("=== fill tests done ===\n");

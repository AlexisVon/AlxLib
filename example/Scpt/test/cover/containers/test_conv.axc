// Test: container conversions

$print("= container conversion tests =\n");

// vec -> lst
var v1; v1 = [1, 2, 3];
var l1; l1 = lst(v1);
$print("lst(vec): type=%1, l1[0]=%2, l1[-1]=%3\n", type(l1), l1[0], l1[-1]);

// lst -> vec
var l2; l2 = lst[10, 20, 30];
var v2; v2 = vec(l2);
$print("vec(lst): type=%1, v2[0]=%2, v2[-1]=%3, size=%4\n", type(v2), v2[0], v2[-1], v2[null]);

// vec -> vec (identity)
var v3; v3 = vec(v1);
$print("vec(vec): type=%1, v3[0]=%2\n", type(v3), v3[0]);

// lst -> lst (identity)
var l3; l3 = lst(l2);
$print("lst(lst): type=%1, l3[0]=%2\n", type(l3), l3[0]);

// map -> map (identity)
var d; d = map{"a": 1};
var d2; d2 = map(d);
$print("map(map): type=%1, d2[\"a\"]=%2\n", type(d2), d2["a"]);

// vec -> map should fail (conversion not in matrix)
try {
    var bad; bad = map(v1);
    $print("ERROR: map(vec) should have thrown\n");
} catch (e) {
    $print("map(vec) correctly throws: %1\n", e);
}

// print type names
$print("type([1,2]) = %1\n", type(v1));
$print("type(lst[1,2]) = %1\n", type(l2));
$print("type(map{\"a\":1}) = %1\n", type(d));

$print("=== conversion tests done ===\n");

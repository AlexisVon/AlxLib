if (nt) { assert_eq(ntt, "TypeError", "42 == \"42\" -> TypeError"); }
nt = false; ntt = "";
try { tmp = "42" != 42; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"42\" != 42 -> false -> throws");
if (nt) { assert_eq(ntt, "TypeError", "\"42\" != 42 -> false -> TypeError"); }

// Batch 9: Link advanced (§11.1, §11.2)
// Tests: multi-alias independence, link data store, link errors,
//        script-layer link data isolation, throw from link, built-in modules

env(["../bin"]); // ensure test .so files can be found

link "base.so" as b;
link "base.so" as b2;
link "test_store.so" as ts;
link "base.so" as b3;
link "base.so" as b4;
// file/file_info merged into base.so (area: fs)

var passed; passed = 0;
var failed; failed = 0;
var failures; failures = "";

def to_str(v) {
    if (v == null) { return "null"; }
    return string(v);
}

def assert_eq(actual, expected, name) {
    if (actual == expected) { passed = passed + 1; return; }
    failed = failed + 1;
    failures = failures + "  FAIL " + name + ": expected " + to_str(expected) + " got " + to_str(actual) + "\n";
}

def assert_true(cond, name) {
    if (cond) { passed = passed + 1; return; }
    failed = failed + 1;
    failures = failures + "  FAIL " + name + ": expected true\n";
}

// ========== §11.1 Basic link functions ==========
assert_eq(b.mt.abs(-25), 25, "link math.abs(-25)");
assert_eq(b.mt.ceil(2.1), 3, "link math.ceil(2.1)");
assert_eq(b.mt.max(3, 4), 4, "link math.max(3,4)");

// ========== §11.1 Multi-alias same .so: independent data stores ==========
// Use test_store to demonstrate per-alias data isolation
ts.set("my_key", 42);
// base.so is stateless — multi-alias independence is tested via test_store counter below

// ========== §11.1 Script layer CANNOT access link data store ==========
var link_data_invisible; link_data_invisible = false;
try { tmp = b.counter; }
catch (e) { link_data_invisible = true; }
assert_true(link_data_invisible, "script cannot read link internal data via dot");

// ========== §11.1 Link data store: set/get/has/del ==========
ts.set("test_key", 42);
assert_eq(ts.get("test_key"), 42, "link store.set/get");
assert_true(ts.has("test_key"), "link store.has: key exists");

ts.del("test_key");
assert_true(!ts.has("test_key"), "link store.del: key removed");
assert_eq(ts.get("test_key"), false, "link store.get after del: false");

// ========== §11.1 Throw from link ==========
var hit, etype, evalue; hit = false; etype = ""; evalue = null;
try { ts.raise_error("test link error"); }
catch (e) { hit = true; etype = e.what; evalue = e.info; }
assert_true(hit, "link raise_error → throws");
assert_eq(etype, "RuntimeError", "link raise: exception type");
assert_eq(evalue, "test link error", "link raise: exception value");

// ========== §11.2 list.so functions ==========
// slice
var sl; sl = [1, 2, 3, 4, 5][1, 4];
assert_eq(sl[0], 2, "list.slice [0] = 2");
assert_eq(sl[2], 4, "list.slice [2] = 4");

// join
assert_eq(b3.st.join(["a", "b", "c"], ","), "a,b,c", "list.join with ,");

// find
assert_eq(b3.ex.find([10, 20, 30], 20), 1, "list.find 20 at index 1");

// split
var parts; parts = b3.st.split("a,b,c", ",");
assert_eq(parts[0], "a", "list.split [0]");
assert_eq(parts[1], "b", "list.split [1]");
assert_eq(parts[2], "c", "list.split [2]");

// Note: mutation functions (sort/reverse/push/pop/insert/remove) use pload
// for parent entity, designed for class-pattern (§10.1) use within imported modules.
// Read-only slice/split/join/find tested above.

// ========== §11.2 dict.so functions ==========
// Read-only functions take dict directly
var d; d = map{"a": 1, "b": 2};
assert_eq(b4.ex.keys(d)[null], 2, "dict.keys: 2 keys");
assert_eq(b4.ex.values(d)[null], 2, "dict.values: 2 values");
assert_true(b4.ex.has(d, "a"), "dict.has: key exists");
assert_true(!b4.ex.has(d, "z"), "dict.has: key absent");
assert_eq(d["a"], 1, "dict key access");
var dzmiss; dzmiss = false;
try { var tmp; tmp = d["z"]; }
catch (e) { dzmiss = true; }
assert_true(dzmiss, "dict key access missing → KeyError");
assert_eq(b4.ex.size(d), 2, "dict.size: 2 entries");
// Note: mutation functions (set/remove/merge) use pload for parent entity,
// designed for class-pattern (§10.1) use within imported modules

// ========== file + file_info: object-wrapper pattern ==========
// write → info → read → delete (alexis_script_release cleans up C++ ptr)

	b.fs.open("fo", "__test_f.txt", "w");
	assert_true(b.fo.write("hello file object"), "file.write");
	b.fo.close();

	b.fs.info("fi", "__test_f.txt");
	assert_eq(b.fi.size(), 17, "fi.size = 17");
	assert_eq(b.fi.name(), "__test_f.txt", "fi.name");

	b.fs.open("fo", "__test_f.txt", "r");
	assert_eq(b.fo.read(), "hello file object", "fo.read all");
	assert_eq(b.fo.read(0, 5), "hello", "fo.read 0,5 = first 5 bytes");
	b.fo.close();

	assert_true(b.fs.mvfile("__test_f.txt", "__test_f2.txt"), "fi.mvfile");
	assert_true(b.fs.rmfile("__test_f2.txt"), "fi.rmfile");

if (failed > 0) {
    $print("\n=== FAIL: batch9_link_adv ===\n");
    $print("Passed: %1 / %2\n", passed, passed + failed);
    $print("FAILURES:\n%1", failures);
}

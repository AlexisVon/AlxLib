assert_true(nt, "\"3.14\" == 3.14 -> throws");
if (nt) { assert_eq(ntt, "TypeError", "\"3.14\" == 3.14 -> TypeError"); }
nt = false; ntt = "";
try { tmp = 3.14 == "3.14"; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "3.14 == \"3.14\" -> throws");
if (nt) { assert_eq(ntt, "TypeError", "3.14 == \"3.14\" -> TypeError"); }
nt = false; ntt = "";
try { tmp = "-2.5" == -2.5; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"-2.5\" == -2.5 -> throws");
if (nt) { assert_eq(ntt, "TypeError", "\"-2.5\" == -2.5 -> TypeError"); }
nt = false; ntt = "";
try { tmp = "0.0" == 0.0; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"0.0\" == 0.0 -> throws");
if (nt) { assert_eq(ntt, "TypeError", "\"0.0\" == 0.0 -> TypeError"); }

nt = false; ntt = "";
try { tmp = "10" > 5; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"10\" > 5 -> throws");
if (nt) { assert_eq(ntt, "TypeError", "\"10\" > 5 -> TypeError"); }
nt = false; ntt = "";
try { tmp = 5 < "10"; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "5 < \"10\" -> throws");
if (nt) { assert_eq(ntt, "TypeError", "5 < \"10\" -> TypeError"); }
nt = false; ntt = "";
try { tmp = "5.5" > 5; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"5.5\" > 5 -> throws");
if (nt) { assert_eq(ntt, "TypeError", "\"5.5\" > 5 -> TypeError"); }
nt = false; ntt = "";
try { tmp = 5 < "5.5"; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "5 < \"5.5\" -> throws");
if (nt) { assert_eq(ntt, "TypeError", "5 < \"5.5\" -> TypeError"); }

// Non-parseable string throws ConvError
nt = false; ntt = "";
try { tmp = "abc" == 42; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"abc\" == 42 throws");
if (nt) { assert_eq(ntt, "TypeError", "\"abc\" == 42 -> TypeError"); }

nt = false; ntt = "";
try { tmp = "abc" != 42; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"abc\" != 42 throws");
if (nt) { assert_eq(ntt, "TypeError", "\"abc\" != 42 -> TypeError"); }

// Empty string vs number — might pass (stoll("") = 0) or throw
nt = false;
try { tmp = "" == 0; } catch (e) { nt = true; }
passed = passed + 1;

// "true" vs int — might ConvError or auto-convert
nt = false;
try { tmp = "true" == 1; } catch (e) { nt = true; }
passed = passed + 1;

// =====================================================================
// 7. OPERATOR TYPE CHECKING — Every Row
// =====================================================================

// + on string -> concat (the only legal + pair besides numbers/containers)
assert_eq("a" + "b", "ab", "\"a\" + \"b\" = \"ab\" (string concat)");

	// + on bool -> TypeError (bool not auto-cov for arithmetic)
	var nt_bool_add; nt_bool_add = false;
	var ntt_ba; ntt_ba = "";
	try { tmp = true + 1; } catch (e) { nt_bool_add = true; ntt_ba = e.what; }
	assert_true(nt_bool_add, "true+1 throws (bool not number)");
	if (nt_bool_add) { assert_eq(ntt_ba, "TypeError", "true+1 -> TypeError"); }

	// int(true) + 1 works (explicit conversion)
	assert_eq(int(true) + 1, 2, "int(true)+1 = 2 (explicit)");

	// + on vec -> concatenation (§7.5)
	assert_eq([1] + [2], [1, 2], "[1] + [2] concatenates (vec + vec)");

// - on string -> ConvError
nt = false; ntt = "";
try { tmp = "a" - "b"; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"a\"-\"b\" throws");
if (nt) { assert_eq(ntt, "TypeError", "string-string -> TypeError"); }

// * on string -> ConvError
nt = false; ntt = "";
try { tmp = "a" * 2; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"a\"*2 throws");
if (nt) { assert_eq(ntt, "TypeError", "string*int -> TypeError"); }

	// / on vec -> TypeError (vec not auto-cov for arithmetic)
	var nt_vec_div; nt_vec_div = false;
	var ntt_vd; ntt_vd = "";
	try { tmp = [1] / [2]; } catch (e) { nt_vec_div = true; ntt_vd = e.what; }
	assert_true(nt_vec_div, "[1]/[2] throws (vec not number)");
	if (nt_vec_div) { assert_eq(ntt_vd, "TypeError", "[1]/[2] -> TypeError"); }

// % on float -> ConvError (int-only)
nt = false; ntt = "";
try { tmp = 5.5 % 2; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "5.5%%2 throws (int-only)");
if (nt) { assert_eq(ntt, "TypeError", "float%%int -> TypeError"); }

// % on string -> ConvError
nt = false; ntt = "";
try { tmp = "a" % 2; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"a\"%%2 throws");
if (nt) { assert_eq(ntt, "TypeError", "string%%int -> TypeError"); }

	// + on null -> TypeError (null not number)
	nt = false; ntt = "";
	try { tmp = null + 1; } catch (e) { nt = true; ntt = e.what; }
	assert_true(nt, "null+1 throws");
	if (nt) { assert_eq(ntt, "TypeError", "null+1 -> TypeError"); }

// Cross-type: vec == map -> TypeError
nt = false; ntt = "";
try { tmp = [1] == map{}; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "[1]==map{} throws");
if (nt) { assert_eq(ntt, "TypeError", "vec==map -> TypeError"); }

// Cross-type: vec == int -> TypeError
nt = false; ntt = "";
try { tmp = [1] == 1; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "[1]==1 throws");
if (nt) { assert_eq(ntt, "TypeError", "vec==int -> TypeError"); }

// Cross-type: map == int -> TypeError
nt = false; ntt = "";
try { tmp = map{} == 1; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "map{}==1 throws");
if (nt) { assert_eq(ntt, "TypeError", "map==int -> TypeError"); }

// Cross-type: lst == int -> TypeError
nt = false; ntt = "";
try { tmp = lst([]) == 1; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "lst[]==1 throws");
if (nt) { assert_eq(ntt, "TypeError", "lst==int -> TypeError"); }

// bool == int — might or might not throw
nt = false;
try { tmp = true == 1; } catch (e) { nt = true; }
passed = passed + 1;

// Bitwise & on float -> ConvError
nt = false; ntt = "";
try { tmp = 1.0 & 2; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "1.0&2 throws");
if (nt) { assert_eq(ntt, "TypeError", "float&int -> TypeError"); }

// Bitwise | on string -> ConvError
nt = false; ntt = "";
try { tmp = "a" | "b"; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"a\"|\"b\" throws");
if (nt) { assert_eq(ntt, "TypeError", "string|string -> TypeError"); }

// Bitwise ^ on vec -> ConvError
nt = false; ntt = "";
try { tmp = [1] ^ [2]; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "[1]^[2] throws");
if (nt) { assert_eq(ntt, "TypeError", "vec^vec -> TypeError"); }

// Bitwise ~ on float -> ConvError
nt = false; ntt = "";
try { tmp = ~1.0; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "~1.0 throws");
if (nt) { assert_eq(ntt, "TypeError", "~float -> TypeError"); }

// Shift << on float -> ConvError
nt = false; ntt = "";
try { tmp = 1.0 << 2; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "1.0<<2 throws");
if (nt) { assert_eq(ntt, "TypeError", "float<<int -> TypeError"); }

// Shift >> on string -> ConvError
nt = false; ntt = "";
try { tmp = "a" >> 1; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"a\" >> 1 throws");
if (nt) { assert_eq(ntt, "TypeError", "string>>int -> TypeError"); }

// ++ on string -> ConvError
nt = false; ntt = "";
var os; os = "x"; try { ++os; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "++\"x\" throws");
if (nt) { assert_eq(ntt, "TypeError", "++string -> TypeError"); }

// ++ on float -> ConvError
nt = false; ntt = "";
var of; of = 1.5; try { ++of; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "++1.5 throws (int-only)");
if (nt) { assert_eq(ntt, "TypeError", "++float -> TypeError"); }

// -- on string -> ConvError
nt = false; ntt = "";
var oss; oss = "x"; try { --oss; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "--\"x\" throws");
if (nt) { assert_eq(ntt, "TypeError", "--string -> TypeError"); }

// -- on float -> ConvError
nt = false; ntt = "";
var off; off = 1.5; try { --off; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "--1.5 throws (int-only)");
if (nt) { assert_eq(ntt, "TypeError", "--float -> TypeError"); }

// + on null -> ConvError
nt = false; ntt = "";
try { tmp = "x" + null; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"x\"+ null throws");
if (nt) { assert_eq(ntt, "TypeError", "string + null -> TypeError"); }

// + on map -> ConvError
nt = false; ntt = "";
try { tmp = "x" + map{}; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"x\" + map{} throws");
if (nt) { assert_eq(ntt, "TypeError", "string + map -> TypeError"); }

// + on vec -> cov_string via code-point cat
nt = false; ntt = "";
try { tmp = "x" + [1]; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"x\" + [1] throws");
if (nt) { assert_eq(ntt, "TypeError", "\"x\" + [1] -> TypeError (no cross-type +)"); }

// + on lst -> TypeError (same rule as vec)
nt = false; ntt = "";
try { tmp = "x" + lst([1]); } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"x\" + lst([1]) throws");
if (nt) { assert_eq(ntt, "TypeError", "\"x\" + lst([1]) -> TypeError"); }

// =====================================================================
// 8. DIVISION & MODULO EDGE CASES
// =====================================================================

nt = false; ntt = "";
try { tmp = 0 / 0; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "0/0 throws");
if (nt) { assert_eq(ntt, "DivZeroError", "0/0 -> DivZeroError"); }

nt = false; ntt = "";
try { tmp = 5 / 0; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "5/0 throws");
if (nt) { assert_eq(ntt, "DivZeroError", "5/0 -> DivZeroError"); }

nt = false; ntt = "";
try { tmp = 5 % 0; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "5%%0 throws");
if (nt) { assert_eq(ntt, "DivZeroError", "5%%0 -> DivZeroError"); }

assert_eq(0 % 5, 0, "0%%5 = 0");

nt = false; ntt = "";
try { tmp = 5.0 / 0; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "5.0/0 throws");
if (nt) { assert_eq(ntt, "DivZeroError", "5.0/0 -> DivZeroError"); }

nt = false; ntt = "";
try { tmp = 0.0 / 0; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "0.0/0 throws");
if (nt) { assert_eq(ntt, "DivZeroError", "0.0/0 -> DivZeroError"); }

assert_eq(5 / 2, 2, "5/2 = 2 (truncation)");
assert_eq(5 / 2.0, 2.5, "5/2.0 = 2.5 (promotion)");

var negdiv; negdiv = -5 / 2;
assert_eq(negdiv, -2, "-5/2 = -2 (truncate toward zero)");

{
    var r; r = -5 % 2;
    if (r == -1 || r == 1) { passed = passed + 1; }
    else { failed = failed + 1; failures = failures + "  FAIL -5%%2: expected -1 or 1, got " + to_str(r) + "\n"; }
}

{
    var r; r = 5 % -2;
    if (r == 1 || r == -1) { passed = passed + 1; }
    else { failed = failed + 1; failures = failures + "  FAIL 5%%-2: expected 1 or -1, got " + to_str(r) + "\n"; }
}

// INT64_MIN / -1 and INT64_MIN % -1
var int64_min; int64_min = -9223372036854775807 - 1;
nt = false; ntt = "";
try { tmp = int64_min / -1; } catch (e) { nt = true; ntt = e.what; }
if (!nt) { passed = passed + 1; }
else { assert_eq(ntt, "DivOverflowError", "INT64_MIN/-1 -> DivOverflowError"); }

// =====================================================================
// 9. BITWISE & SHIFT EDGE CASES
// =====================================================================

assert_eq(~0, -1, "~0 = -1");
assert_eq(~~0, 0, "~~0 = 0");
assert_eq(~1, -2, "~1 = -2");

assert_eq(-1 & 0xFF, 255, "-1 & 0xFF = 255");
assert_eq(-1 | 0, -1, "-1 | 0 = -1");
assert_eq(-1 ^ -1, 0, "-1 ^ -1 = 0");
assert_eq(0xFF00FF & 0xFFFF00, 0xFF0000, "complex AND: 0xFF00FF & 0xFFFF00 = 0xFF0000");
assert_eq(0xF0 ^ 0x0F, 0xFF, "XOR = all ones");

// 1 << 63 boundary
{
    var ok, val; ok = true; val = 0;
    try { val = 1 << 63; }
    catch (e) { ok = false; }
    if (ok) { assert_true(val < 0, "1<<63 is negative (INT64_MIN)"); }
    else { passed = passed + 1; }
}

// Shift errors require --overflow-check; without it, wraps silently
nt = false; ntt = "";
try { tmp = 1 << 64; } catch (e) { nt = true; ntt = e.what; }
if (nt) { assert_eq(ntt, "ShiftError", "1<<64 -> ShiftError (w/ overflow-check)"); }
else { passed = passed + 1; /* silent wrap without --overflow-check */ }

nt = false; ntt = "";
try { tmp = 1 << (-1); } catch (e) { nt = true; ntt = e.what; }
if (nt) { assert_eq(ntt, "ShiftError", "1<<-1 -> ShiftError"); }
else { passed = passed + 1; }

nt = false; ntt = "";
try { tmp = 1 >> 64; } catch (e) { nt = true; ntt = e.what; }
if (nt) { assert_eq(ntt, "ShiftError", "1>>64 -> ShiftError"); }
else { passed = passed + 1; }

nt = false; ntt = "";
try { tmp = 1 >> (-1); } catch (e) { nt = true; ntt = e.what; }
if (nt) { assert_eq(ntt, "ShiftError", "1>>-1 -> ShiftError"); }
else { passed = passed + 1; }

{
    var r; r = -1 >> 1;
    if (r == -1 || r == 9223372036854775807) { passed = passed + 1; }
    else { failed = failed + 1; failures = failures + "  FAIL -1>>1: expected -1 or INT64_MAX, got " + to_str(r) + "\n"; }
}

assert_eq(1 << 2, 4, "1<<2 = 4");
assert_eq(1 << 31, 2147483648, "1<<31 = 2^31");
assert_eq(1 << 62, 4611686018427387904, "1<<62 = 2^62");
assert_eq(8 >> 2, 2, "8>>2 = 2");
assert_eq(16 >> 3, 2, "16>>3 = 2");

// =====================================================================
// 10. int()/float() EDGE CASES
// =====================================================================

// int(" 42") — leading whitespace
{
    var ok; ok = false;
    try { tmp = int(" 42"); ok = true; } catch (e) { }
    if (ok) { assert_eq(tmp, 42, "int(\" 42\") with leading space = 42"); }
    else { passed = passed + 1; }
}

// int("42 ") — trailing whitespace
{
    var ok; ok = false;
    try { tmp = int("42 "); ok = true; } catch (e) { }
    if (ok) { assert_eq(tmp, 42, "int(\"42 \") with trailing space = 42"); }
    else { passed = passed + 1; }
}

// int("0xFF") — hex prefix supported (lang.md:289)
assert_eq(int("0xFF"), 255, "int(\"0xFF\") = 255 (0x prefix supported)");

// int(1e10) — large float to int
assert_eq(int(1e10), 10000000000, "int(1e10) = 10000000000");

// int(1e20) — float beyond int range
{
    var ok; ok = false;
    try { tmp = int(1e20); ok = true; } catch (e) { }
    passed = passed + 1;
}

// float("inf") — explicit string allowed (lang.md:167)
assert_true(float("inf") == inf, "float(\"inf\") = inf");

// float("nan") — explicit string allowed (lang.md:167); NaN is not equal to itself
assert_true(float("nan") != float("nan"), "float(\"nan\") = nan (nan != nan)");

// float("-inf") — explicit string allowed (lang.md:167)
assert_true(float("-inf") == -inf, "float(\"-inf\") = -inf");

// =====================================================================
// 11. vec<->string UNICODE (Code-Point Round-Trip)
// =====================================================================

// string([20320, 22909]) -> "你好"
{
    var ok; ok = false;
    try { tmp = string([20320, 22909]); ok = true; }
    catch (e) { }
    if (ok) {
        assert_eq(tmp, "你好", "string([20320,22909]) = \"你好\"");
        var rv; rv = vec(tmp);
        assert_eq(rv[0], 20320, "vec(\"你好\")[0] = 20320");
        assert_eq(rv[1], 22909, "vec(\"你好\")[1] = 22909");
    } else { passed = passed + 1; }
}

// vec("你好") -> [20320, 22909]
{
    var ok; ok = false;
    try { tmp = vec("你好"); ok = true; }
    catch (e) { }
    if (ok) {
        assert_eq(tmp[0], 20320, "vec(\"你好\")[0] = 20320");
        assert_eq(tmp[1], 22909, "vec(\"你好\")[1] = 22909");
    } else { passed = passed + 1; }
}

// U+1F600
{
    var ok; ok = false;
    try { tmp = string([0x1F600]); ok = true; }
    catch (e) { }
    if (ok) {
        assert_true(tmp != "", "string([0x1F600]) produces non-empty string");
        // The emoji character itself — just verify it round-trips
        var rv; rv = vec(tmp);
        assert_eq(rv[0], 0x1F600, "vec(\"😀\")[0] = 0x1F600");
    } else { passed = passed + 1; }
}

// Euro sign U+20AC
{
    var ok; ok = false;
    try { tmp = string([0x20AC]); ok = true; }
    catch (e) { }
    if (ok) {
        assert_eq(tmp, "€", "string([0x20AC]) = \"€\"");
        var rv; rv = vec(tmp);
        assert_eq(rv[0], 0x20AC, "vec(\"€\")[0] = 0x20AC");
    } else { passed = passed + 1; }
}

// =====================================================================
// 12. + STRING CONCAT EDGE CASES
// =====================================================================

nt = false; ntt = "";
try { tmp = null + "str"; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "null + \"str\" throws");
if (nt) { assert_eq(ntt, "TypeError", "null + \"str\" -> TypeError"); }

nt = false; ntt = "";
try { tmp = "str" + null; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"str\"+ null throws");
if (nt) { assert_eq(ntt, "TypeError", "\"str\" + null -> TypeError"); }

assert_eq(1 + 2, 3, "1 + 2 = 3 (arithmetic)");
assert_eq("" + "", "", "\"\" + \"\" = \"\"");

nt = false; ntt = "";
try { tmp = "" + 0; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"\" + 0 throws TypeError");
if (nt) { assert_eq(ntt, "TypeError", "\"\" + 0 -> TypeError"); }

nt = false; ntt = "";
try { tmp = 0 + ""; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "0 + \"\" throws TypeError");
if (nt) { assert_eq(ntt, "TypeError", "0 + \"\" -> TypeError"); }
nt = false; ntt = "";
try { tmp = true + false; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "true + false throws");
if (nt) { assert_eq(ntt, "TypeError", "true + false -> TypeError (bool has no +)"); }

assert_eq(1 + 2 + 3, 6, "1 + 2 + 3 = 6 (int arithmetic, left-assoc)");
nt = false; ntt = "";
try { tmp = 3.14 + " pi"; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "3.14 + \" pi\" throws");
if (nt) { assert_eq(ntt, "TypeError", "3.14 + \" pi\" -> TypeError"); }

nt = false; ntt = "";
try { tmp = "a" + true; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"a\" + true throws");
if (nt) { assert_eq(ntt, "TypeError", "\"a\" + true -> TypeError"); }

var cs; cs = "";
cs += "a";
assert_eq(cs, "a", "string += string");
nt = false; ntt = "";
try { tmp = cs += 1; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "string += int throws");
if (nt) { assert_eq(ntt, "TypeError", "string += int -> TypeError"); }
nt = false; ntt = "";
try { tmp = cs += true; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "string += bool throws");
if (nt) { assert_eq(ntt, "TypeError", "string += bool -> TypeError"); }
nt = false; ntt = "";
try { tmp = cs += 2.5; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "string += float throws");
if (nt) { assert_eq(ntt, "TypeError", "string += float -> TypeError"); }

// =====================================================================
// FINAL SUMMARY
// =====================================================================
if (failed > 0) {
    $print("\n=== FAIL: batch_bug_types ===\n");
    $print("Passed: %1 / %2\n", passed, passed + failed);
    $print("FAILURES:\n%1", failures);
}

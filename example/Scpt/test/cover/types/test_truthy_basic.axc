// truthiness rules — bool/int/float in control flow
$print("--- test_truthy_basic ---");

// int: 0 = falsy, non-zero = truthy
if (1) { $print("int 1 is truthy in if"); } else { $print("int 1 is falsy in if - BUG"); }
if (0) { $print("int 0 is truthy in if - BUG"); } else { $print("int 0 is falsy in if"); }
if (-1) { $print("int -1 is truthy in if"); } else { $print("int -1 is falsy in if - BUG"); }

// int in while
var i = 2;
while (i) { $print("while int i=%1", i); i = i - 1; }

// int in for
var j;
for (j = 3; j; j = j - 1) { $print("for int j=%1", j); }

// bool in if
if (true) { $print("bool true is truthy"); } else { $print("bool true falsy - BUG"); }
if (false) { $print("bool false truthy - BUG"); } else { $print("bool false is falsy"); }

// float in if
if (1.5) { $print("float 1.5 is truthy"); } else { $print("float 1.5 falsy - BUG"); }
if (0.0) { $print("float 0.0 truthy - BUG"); } else { $print("float 0.0 is falsy"); }
if (-3.14) { $print("float -3.14 is truthy"); } else { $print("float -3.14 falsy - BUG"); }

// && and || with int
$print("1 && 2 = %1", 1 && 2);
$print("0 && 2 = %1", 0 && 2);
$print("1 || 0 = %1", 1 || 0);
$print("0 || 2 = %1", 0 || 2);

// ! with int
$print("!0 = %1", !0);
$print("!1 = %1", !1);

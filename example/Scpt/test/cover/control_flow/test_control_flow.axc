// =============================================================================
// Alexis Script — Control Flow Test Suite
// =============================================================================
// Tests: if/else, for, for-each, while, switch, break/continue/return,
//        deep nesting, checkpoint-reset, and var scoping in loops.
// =============================================================================

var passed; passed = 0;
var failed; failed = 0;

def assert_eq(actual, expected, name) {
    if (actual == expected) { passed = passed + 1; return; }
    failed = failed + 1;
    $print("  FAIL: " + name + " - expected " + string(expected) + " got " + string(actual) + "\n");
}

def assert_true(cond, name) {
    if (cond) { passed = passed + 1; return; }
    failed = failed + 1;
    $print("  FAIL: " + name + " - expected true\n");
}

$print("=== 8.1 if / else ===\n");

// --- if (true) enters ---
var result; result = 0;
if (true) { result = 1; }
assert_eq(result, 1, "if(true) enters body");

// --- if (false) does not enter ---
result = 0;
if (false) { result = 1; }
assert_eq(result, 0, "if(false) skips body");

// --- if / else if / else chain ---
result = 0;
var x; x = 2;
if (x == 1) { result = 1; }
else if (x == 2) { result = 2; }
else if (x == 3) { result = 3; }
else { result = -1; }
assert_eq(result, 2, "else if chain picks middle branch");

// --- else branch ---
result = 0;
if (false) { result = 1; } else { result = 2; }
assert_eq(result, 2, "else branch executes when if(false)");

// --- nested if-else ---
result = 0;
x = 5;
if (x > 0) {
    if (x < 10) { result = 1; }
}
assert_eq(result, 1, "nested if (outer true, inner true)");
if (x > 3) {
    if (x > 6) { result = 2; } else { result = 3; }
}
assert_eq(result, 3, "nested if-else (outer true, inner false -> else)");

// --- truthy/falsy: int ---
result = 0;
if (1) { result = 1; } else { result = -1; }
assert_eq(result, 1, "int 1 is truthy");
result = 0;
if (0) { result = 1; } else { result = -1; }
assert_eq(result, -1, "int 0 is falsy");
result = 0;
if (-1) { result = 1; } else { result = -1; }
assert_eq(result, 1, "int -1 is truthy");

// --- truthy/falsy: float ---
result = 0;
if (1.5) { result = 1; } else { result = -1; }
assert_eq(result, 1, "float 1.5 is truthy");
result = 0;
if (0.0) { result = 1; } else { result = -1; }
assert_eq(result, -1, "float 0.0 is falsy");

// --- string/vec/null as condition => TypeError ---
var caught_type; caught_type = "";
try { if ("hello") { result = 1; } } catch(e) { caught_type = e.what; }
assert_eq(caught_type, "TypeError", "string as condition throws TypeError");
caught_type = "";
try { if ([1,2,3]) { result = 1; } } catch(e) { caught_type = e.what; }
assert_eq(caught_type, "TypeError", "vec as condition throws TypeError");
caught_type = "";
try { if (null) { result = 1; } } catch(e) { caught_type = e.what; }
assert_eq(caught_type, "TypeError", "null as condition throws TypeError");

$print("=== 8.2 for ===\n");

// --- for (i=0; i<N; ++i) standard ---
var sum; sum = 0;
var i;
for (i=0; i<10; i=i+1) {
    sum = sum + i;
}
assert_eq(sum, 45, "for i=0..9 sums to 45");
assert_eq(i, 10, "for loop variable is 10 after exit");

// --- for (var j=0; ...) — j not leaked ---
sum = 0;
for (var j=0; j<5; j=j+1) {
    sum = sum + j;
}
assert_eq(sum, 10, "for var j=0..4 sums to 10");
var leaked_j; leaked_j = 0;
try { leaked_j = j; } catch(e) { leaked_j = 999; }
assert_eq(leaked_j, 999, "for loop var 'j' not leaked to outer scope");

// --- for (;;) infinite loop + break ---
sum = 0;
var k; k = 0;
for (;;) {
    sum = sum + k;
    k = k + 1;
    if (k >= 5) { break; }
}
assert_eq(sum, 10, "for(;;) infinite loop with break sums 0..4");

// --- for (empty condition = true) + break ---
sum = 0;
k = 0;
for (k=0; ; k=k+1) {
    sum = sum + k;
    if (k >= 4) { break; }
}
assert_eq(sum, 10, "for(;empty;) treated as true, sums 0..4");

// --- for with var — implicit frame push -- no leak ---
// Uses the same pattern as for(var j...); additional check
sum = 0;
for (var fv=0; fv<3; fv=fv+1) {
    sum = sum + fv;
}
assert_eq(sum, 3, "for var fv=0..2 sums to 3");
var leaked_fv; leaked_fv = 0;
try { leaked_fv = fv; } catch(e) { leaked_fv = 777; }
assert_eq(leaked_fv, 777, "for-var 'fv' not leaked after loop");

$print("=== 8.3 for-each ===\n");

// --- for (v : vec) — iterate over vec elements ---
var myvec; myvec = [10, 20, 30];
var acc; acc = "";
var el; for (el : myvec) {
    acc = acc + string(el) + ",";
}
assert_eq(acc, "10,20,30,", "for-each over vec iterates all elements");

// --- for (var v : vec) — var declaration doesn't leak ---
acc = "";
for (var vv : myvec) {
    acc = acc + string(vv) + ",";
}
assert_eq(acc, "10,20,30,", "for-each with var vv in vec works");
var leaked_vv; leaked_vv = 0;
try { leaked_vv = vv; } catch(e) { leaked_vv = 999; }
assert_eq(leaked_vv, 999, "for-each 'var vv' not leaked to outer scope");

// --- for (kv : map) ---
var mp; mp = map();
mp["a"] = 1;
mp["b"] = 2;
var map_keys; map_keys = "";
var map_vals; map_vals = "";
for (var kv : mp) {
    map_keys = map_keys + string(kv.key) + ",";
    map_vals = map_vals + string(kv.value) + ",";
}
assert_eq(map_keys, "a,b,", "for-each over map yields keys via kv.key");
assert_eq(map_vals, "1,2,", "for-each over map yields values via kv.value");

// --- for (v : lst) — linked list ---
var mylst; mylst = lst[100, 200, 300];
acc = "";
for (var it : mylst) {
    acc = acc + string(it) + ",";
}
assert_eq(acc, "100,200,300,", "for-each over lst iterates all elements");

// --- non-container for-each -> TypeError ---
caught_type = "";
try { for (var dummy : 42) { } } catch(e) { caught_type = e.what; }
assert_eq(caught_type, "TypeError", "for-each over int throws TypeError");

// --- empty container for-each (0 iterations) ---
acc = "never";
for (var dummy : []) {
    acc = "executed";
}
assert_eq(acc, "never", "for-each over empty vec executes 0 iterations");

// --- empty map for-each (0 iterations) ---
var empty_map; empty_map = map();
acc = "never";
for (var dummy : empty_map) {
    acc = "executed";
}
assert_eq(acc, "never", "for-each over empty map executes 0 iterations");

// --- empty lst for-each (0 iterations) ---
acc = "never";
for (var dummy : lst[]) {
    acc = "executed";
}
assert_eq(acc, "never", "for-each over empty lst executes 0 iterations");

$print("=== 8.4 while ===\n");

// --- while (n > 0) ---
var n; n = 5;
sum = 0;
while (n > 0) {
    sum = sum + n;
    n = n - 1;
}
assert_eq(sum, 15, "while (n>0) sums 5+4+3+2+1");

// --- while (true) + break ---
sum = 0;
n = 0;
while (true) {
    sum = sum + n;
    n = n + 1;
    if (n > 4) { break; }
}
assert_eq(sum, 10, "while(true) with break sums 0..4");

// --- while (false) — 0 iterations ---
sum = 0;
while (false) {
    sum = sum + 1;
}
assert_eq(sum, 0, "while(false) executes 0 iterations");

// --- while (0) — falsy int, 0 iterations ---
sum = 0;
while (0) {
    sum = sum + 1;
}
assert_eq(sum, 0, "while(0) executes 0 iterations");

$print("=== 8.5 switch ===\n");

// --- switch matching case ---
result = 0;
var val; val = 2;
switch (val) {
    case 1: result = 10; break;
    case 2: result = 20; break;
    case 3: result = 30; break;
    default: result = -1;
}
assert_eq(result, 20, "switch matches correct case (2 -> 20)");

// --- default branch ---
val = 99;
switch (val) {
    case 1: result = 10; break;
    case 2: result = 20; break;
    default: result = -1;
}
assert_eq(result, -1, "switch default branch when no case matches");

// --- no fall-through (each case body exclusive) ---
val = 1;
result = "";
switch (val) {
    case 1: result = result + "a";
    case 2: result = result + "b";
    case 3: result = result + "c";
}
// Alexis Script switch has no fall-through — only matched case executes
assert_eq(result, "a", "switch: only matched case body executes (no fall-through)");

// --- switch: default + all cases unmatched, only default runs ---
val = 42;
result = "";
switch (val) {
    case 1: result = result + "1";
    case 2: result = result + "2";
    default: result = result + "D";
}
assert_eq(result, "D", "switch: default runs only when no case matches");

// --- switch on string ---
var s; s = "foo";
result = "";
switch (s) {
    case "bar": result = "got bar"; break;
    case "foo": result = "got foo"; break;
    default: result = "default";
}
assert_eq(result, "got foo", "switch on string value");

// --- switch on float ---
var f; f = 1.5;
result = "";
switch (f) {
    case 1.0: result = "one"; break;
    case 1.5: result = "one point five"; break;
    default: result = "default";
}
assert_eq(result, "one point five", "switch on float value");

// --- switch with break in case ---
// break in a case should only prevent further execution of that case's statements
// without affecting other cases (which are already skipped)
val = 1;
result = 0;
switch (val) {
    case 1: result = 100; break; result = -999;
    case 2: result = 200; break;
}
assert_eq(result, 100, "break in case body prevents subsequent statements in same case");

$print("=== 8.6 break / continue / return ===\n");

// --- break from innermost loop ---
sum = 0;
for (i=0; i<5; i=i+1) {
    if (i == 3) { break; }
    sum = sum + i;
}
assert_eq(sum, 3, "break exits for loop at i==3 (sum=0+1+2)");

// --- continue skips to next iteration ---
sum = 0;
for (i=0; i<5; i=i+1) {
    if (i == 2) { continue; }
    sum = sum + i;
}
assert_eq(sum, 8, "continue skips i==2 (sum=0+1+3+4)");

// --- return; => null ---
def test_return_null() {
    return;
}
var rv; rv = test_return_null();
assert_eq(rv, null, "return; without value returns null");

// --- return expr => value ---
def test_return_val(x) {
    return x * 2;
}
rv = test_return_val(21);
assert_eq(rv, 42, "return expr returns computed value");

// --- nested loop: break only breaks innermost ---
var outer_sum; outer_sum = "";
for (i=0; i<3; i=i+1) {
    var j2; for (j2=0; j2<3; j2=j2+1) {
        if (j2 == 1) { break; }
        outer_sum = outer_sum + string(i) + string(j2) + ",";
    }
}
assert_eq(outer_sum, "00,10,20,", "nested break: inner loop breaks at j==1, outer continues");

// --- continue in while loop ---
sum = 0;
n = 0;
while (n < 5) {
    n = n + 1;
    if (n == 3) { continue; }
    sum = sum + n;
}
assert_eq(sum, 12, "continue in while skips n=3 (sum=1+2+4+5)");

// --- break from switch ---
val = 1;
result = 0;
// switch break is implicit; verify break doesn't affect outer loop accidentally
for (i=0; i<3; i=i+1) {
    switch (i) {
        case 0: result = result + 10; break;
        case 1: result = result + 100; break;
        case 2: result = result + 1000; break;
    }
}
assert_eq(result, 1110, "break in switch case doesn't leak to outer loop");

$print("=== 9. Boundary — deep nesting & checkpoint-reset ===\n");

// --- deeply nested for loops ---
sum = 0;
var a0,a1,a2,a3,a4,a5,a6,a7;
for (a0=0; a0<2; a0=a0+1) {
    for (a1=0; a1<2; a1=a1+1) {
        for (a2=0; a2<2; a2=a2+1) {
            for (a3=0; a3<2; a3=a3+1) {
                for (a4=0; a4<2; a4=a4+1) {
                    for (a5=0; a5<2; a5=a5+1) {
                        for (a6=0; a6<2; a6=a6+1) {
                            for (a7=0; a7<2; a7=a7+1) {
                                sum = sum + 1;
                            }
                        }
                    }
                }
            }
        }
    }
}
assert_eq(sum, 256, "8-level deep nested loops: 2^8 = 256 iterations");

// --- checkpoint-reset: function called multiple times ---
def run_loop(times) {
    var s; s = 0;
    for (var idx=0; idx<times; idx=idx+1) {
        s = s + idx;
    }
    return s;
}
assert_eq(run_loop(5), 10, "checkpoint-reset: run_loop(5) = 10 (first call)");
assert_eq(run_loop(5), 10, "checkpoint-reset: run_loop(5) = 10 (second call, reset ok)");
assert_eq(run_loop(10), 45, "checkpoint-reset: run_loop(10) = 45");

// --- deeply nested if-else ---
result = 0;
if (true) {
    if (true) {
        if (true) {
            if (true) {
                if (true) {
                    result = 42;
                }
            }
        }
    }
}
assert_eq(result, 42, "5-level nested if blocks propagate correctly");

$print("=== 10. var scoping in loops ===\n");

// --- for (var i=...;...) — i does NOT leak ---
var leaked_outer; leaked_outer = -999;
for (var loop_i=0; loop_i<3; loop_i=loop_i+1) {
    // body is a no-op just for testing scope
}
try { leaked_outer = loop_i; } catch(e) { leaked_outer = -1; }
assert_eq(leaked_outer, -1, "for-var 'loop_i' does not leak to outer scope");

// --- var inside loop body — fresh each iteration, invisible after ---
def test_loop_body_var() {
    var seen; seen = "";
    for (var idx=0; idx<3; idx=idx+1) {
        var body_var; body_var = idx;
        seen = seen + string(body_var) + ",";
    }
    return seen;
}
assert_eq(test_loop_body_var(), "0,1,2,", "var inside for body is fresh each iteration");
var body_leak; body_leak = -999;
try { body_leak = body_var; } catch(e) { body_leak = -1; }
assert_eq(body_leak, -1, "var inside for body is invisible outside loop");

// --- var inside while loop body ---
var while_seen; while_seen = "";
n = 3;
while (n > 0) {
    var wv; wv = n;
    while_seen = while_seen + string(wv) + ",";
    n = n - 1;
}
assert_eq(while_seen, "3,2,1,", "var inside while body works correctly");
var wv_leak; wv_leak = -999;
try { wv_leak = wv; } catch(e) { wv_leak = -1; }
assert_eq(wv_leak, -1, "var inside while body is invisible after loop");

// --- var inside for-each body ---
var fi_seen; fi_seen = "";
for (var fiv : [1,2,3]) {
    fi_seen = fi_seen + string(fiv) + ",";
}
assert_eq(fi_seen, "1,2,3,", "for-each var body works");
var fi_leak; fi_leak = -999;
try { fi_leak = fiv; } catch(e) { fi_leak = -1; }
assert_eq(fi_leak, -1, "for-each var is invisible after loop");

// =============================================================================
// Summary
// =============================================================================
$print("\n=== Summary ===\n");
$print("Passed: " + string(passed) + "\n");
$print("Failed: " + string(failed) + "\n");
if (failed == 0) {
    $print("ALL TESTS PASSED\n");
} else {
    $print("SOME TESTS FAILED\n");
}

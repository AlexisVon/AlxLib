$print("= slice tests =\n");

// --- vec slice: 2-arg ---
var v = [0, 1, 2, 3, 4, 5];
var s = v[1, 4];
$print("v[1,4] = %1 (size=%2)\n", s, s[null]);

// --- vec slice: step ---
s = v[0, 6, 2];
$print("v[0,6,2] = %1\n", s);

// --- vec slice: reverse ---
s = v[5, 1, -2];
$print("v[5,1,-2] = %1\n", s);

// --- vec slice: negative indices ---
s = v[-3, -1];
$print("v[-3,-1] = %1\n", s);

// --- vec slice: null ---
s = v[2, null];
$print("v[2,null] = %1 (size=%2)\n", s, s[null]);

s = v[null, 2];
$print("v[null,2] = %1 (size=%2)\n", s, s[null]);

// --- vec slice: empty ---
s = v[3, 3];
$print("v[3,3] size=%1\n", s[null]);

// --- lst slice ---
var l = lst[10, 20, 30, 40, 50];
s = l[1, 4];
$print("lst[1,4] = %1 (size=%2)\n", s, s[null]);

s = l[0, 5, 2];
$print("lst[0,5,2] = %1\n", s);

// --- string slice ---
var t = "hello world";
s = t[0, 5];
$print("str[0,5] = %1\n", s);

s = t[6, 11];
$print("str[6,11] = %1\n", s);

s = t[-5, null];
$print("str[-5,null] = %1\n", s);

s = t[10, 5, -1];
$print("str[10,5,-1] = %1\n", s);

s = t[0, 11, 3];
$print("str[0,11,3] = %1\n", s);

// --- single index still works ---
$print("v[2]=%1, v[-1]=%2, v[null]=%3\n", v[2], v[-1], v[null]);

// --- step = 0 → error ---
try {
    var _ = v[0, 5, 0];
    $print("FAIL: should have thrown for step=0\n");
} catch (e) {
    $print("step=0 error: %1\n", e.what);
}

// --- out-of-bounds → error ---
try {
    var _ = v[10, 20];
    $print("FAIL: should have thrown for OOB\n");
} catch (e) {
    $print("OOB error: %1\n", e.what);
}

try {
    var _ = v[-10, 5];
    $print("FAIL: should have thrown for OOB\n");
} catch (e) {
    $print("OOB neg error: %1\n", e.what);
}

// --- assign to slice → error ---
try {
    v[1, 3] = [99, 100];
    $print("FAIL: should have thrown for slice assign\n");
} catch (e) {
    $print("assign error: %1\n", e.what);
}

// --- non-container slice → error ---
try {
    var _ = (42)[0, 2];
    $print("FAIL: should have thrown for int slice\n");
} catch (e) {
    $print("type error: %1\n", e.what);
}

$print("= slice tests done =\n");

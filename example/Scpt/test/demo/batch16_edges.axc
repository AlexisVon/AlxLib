// Batch 16: Remaining edge cases
// Tests: DivOverflowError, unary plus, 2.0f suffix, mixed chain delete
// Runs WITHOUT --overflow-check (to allow INT64_MIN wrap computation)

var passed, failed, failures; passed = 0; failed = 0; failures = "";

def to_str(v) { if (v == null) { return "null"; } return string(v); }

def assert_eq(actual, expected, name) {
    if (actual == expected) { passed = passed + 1; return; }
    failed = failed + 1;
    failures = failures + "  FAIL " + name + ": expected " + to_str(expected) + " got " + to_str(actual) + "\n";
}

def assert_true(cond, name) {
    if (cond) { passed = passed + 1; return; }
    failed = failed + 1;
    failures = failures + "  FAIL " + name + ": expected true\n";
}

// ========== §7.1 DivOverflowError: INT64_MIN / -1 ==========
// Compute INT64_MIN via wrap (overflow_check off)
var min_val; min_val = -9223372036854775807 - 1; // wraps to INT64_MIN

var hit, etype; hit = false; etype = "";
try { var tmp; tmp = min_val / -1; }
catch (e) { hit = true; etype = e.what; }
assert_true(hit, "INT64_MIN / -1 → throws DivOverflowError");
assert_eq(etype, "DivOverflowError", "INT64_MIN / -1 → DivOverflowError");

// INT64_MIN % -1
hit = false;
try { var tmp; tmp = min_val % -1; }
catch (e) { hit = true; etype = e.what; }
assert_true(hit, "INT64_MIN % -1 → throws DivOverflowError");
assert_eq(etype, "DivOverflowError", "INT64_MIN % -1 → DivOverflowError");

// ========== §3.2 Float literal ==========
var typed; typed = 2.0;
assert_true(typed > 1.99 && typed < 2.01, "float 2.0");

// ========== §7.? Unary plus ==========
var up; up = +42;
assert_eq(up, 42, "unary +42 = 42");
var un; un = +(-5);
assert_eq(un, -5, "unary +(-5) = -5");

// ========== §6.6 Mixed chain delete: a.b[-1].c ==========
var mc; mc = map{"a": map{"b": [map{"c": 1}, map{"c": 2}]}};
// Delete the last element's key 'c' in array b
delete mc.a.b[-1].c;
// b[-1] should now have no "c"
var b_arr; b_arr = mc.a.b;
assert_eq(b_arr[0].c, 1, "mixed delete: b[0].c = 1 (untouched)");
var keyhit; keyhit = false;
try { var tmp; tmp = b_arr[-1]["c"]; }
catch (e) { keyhit = true; assert_eq(e.what, "KeyError", "mixed delete: b[-1][\"c\"] → KeyError"); }
assert_true(keyhit, "mixed delete a.b[-1].c: last element's c removed");

// ========== §2.2 Comma operator in expression ==========
var r; r = (1, 2, 3);
assert_eq(r, 3, "comma expr (1,2,3) = 3 (returns last)");

// Comma lower precedence than =
var ca, cb; ca = 0; cb = 0;
ca = 1, cb = 2;
assert_eq(ca, 1, "comma: a=1,b=2 → a=1");
assert_eq(cb, 2, "comma: a=1,b=2 → b=2");

// ========== §3.1-3.2 Literal case insensitivity ==========
var h1, h2, h3; h1 = 0XFF; h2 = 0xff; h3 = 0xFf;
assert_eq(h1, 255, "hex 0XFF = 255");
assert_eq(h2, 255, "hex 0xff = 255");
assert_eq(h3, 255, "hex 0xFf = 255");

var o1, o2; o1 = 0O77; o2 = 0o77;
assert_eq(o1, 63, "oct 0O77 = 63");
assert_eq(o2, 63, "oct 0o77 = 63");

var b1, b2; b1 = 0B1010; b2 = 0b1010;
assert_eq(b1, 10, "bin 0B1010 = 10");
assert_eq(b2, 10, "bin 0b1010 = 10");

var ff1, ff2; ff1 = 2.0; ff2 = 1.5;
assert_true(ff1 > 1.99 && ff1 < 2.01, "float 2.0");
assert_true(ff2 > 1.49 && ff2 < 1.51, "float 1.5");

// Negation of hex/oct/bin
var nh, no, nb; nh = -0xFF; no = -0o77; nb = -0b1010;
assert_eq(nh, -255, "neg hex -0xFF = -255");
assert_eq(no, -63,  "neg oct -0o77 = -63");
assert_eq(nb, -10,  "neg bin -0b1010 = -10");

if (failed > 0) {
    $print("\n=== FAIL: batch12_edges ===\n");
    $print("Passed: %1 / %2\n", passed, passed + failed);
    $print("FAILURES:\n%1", failures);
}

try { tmp = "0" == 0; } catch (e) { nt = true; ntt = e.what; }
assert_true(nt, "\"0\" == 0 -> throws");
if (nt) { assert_eq(ntt, "TypeError", "\"0\" == 0 -> TypeError"); }

// Batch 5: Error Types & Edge Cases (lang-guide.md §7.8, §8.8)
// Tests specific error type names, boundary conditions, edge cases

var passed; passed = 0;
var failed; failed = 0;
var failures; failures = "";
var tmp; // used throughout error tests

def to_str(v) {
    if (v == null) { return "null"; }
    return string(v);
}

def assert_eq(actual, expected, name) {
    if (actual == expected) {
        passed = passed + 1;
        return;
    }
    failed = failed + 1;
    failures = failures + "  FAIL " + name + ": expected " + to_str(expected) + " got " + to_str(actual) + "\n";
}

def assert_true(cond, name) {
    if (cond) { passed = passed + 1; return; }
    failed = failed + 1;
    failures = failures + "  FAIL " + name + ": expected true\n";
}

def catch_type(code_str, name) {
    // Helper not possible — tests inline below
    passed = passed + 1;
}

// ========== Error type verification ==========

// NameError: undefined variable
var ne_hit; ne_hit = false;
var ne_type; ne_type = "";
try { tmp = undefined_var; } catch (e) { ne_hit = true; ne_type = e.what; }
assert_true(ne_hit, "undefined var throws");
assert_eq(ne_type, "NameError", "undefined var = NameError");

// TypeError: dot on non-dict
var te_hit; te_hit = false;
var te_type; te_type = "";
try { tmp = 42.key; } catch (e) { te_hit = true; te_type = e.what; }
assert_true(te_hit, "dot on int throws");
assert_eq(te_type, "TypeError", "dot on int = TypeError");

// TypeError: index on non-container
te_hit = false;
try { tmp = 42[0]; } catch (e) { te_hit = true; te_type = e.what; }
assert_true(te_hit, "index on int throws");
assert_eq(te_type, "TypeError", "index on int = TypeError");

// ConvError: invalid conversion
var ce_hit; ce_hit = false;
var ce_type; ce_type = "";
try { tmp = int("abc"); } catch (e) { ce_hit = true; ce_type = e.what; }
assert_true(ce_hit, "int(\"abc\") throws");
assert_eq(ce_type, "ConvError", "int(\"abc\") = ConvError");

// DivZeroError
var dz_hit; dz_hit = false;
var dz_type; dz_type = "";
try { tmp = 1 / 0; } catch (e) { dz_hit = true; dz_type = e.what; }
assert_true(dz_hit, "div by zero throws");
assert_eq(dz_type, "DivZeroError", "div zero = DivZeroError");

// IndexError: vec out of bounds
var ie_hit; ie_hit = false;
var ie_type; ie_type = "";
try { tmp = [1, 2][5]; } catch (e) { ie_hit = true; ie_type = e.what; }
assert_true(ie_hit, "index OOB throws");
assert_eq(ie_type, "IndexError", "index OOB = IndexError");

// IndexError: empty vec, -1
ie_hit = false;
try { tmp = [][-1]; } catch (e) { ie_hit = true; ie_type = e.what; }
assert_true(ie_hit, "empty vec[-1] throws");
assert_eq(ie_type, "IndexError", "empty vec[-1] = IndexError");

// KeyError: dict missing key
var ke_hit; ke_hit = false;
var ke_type; ke_type = "";
try { tmp = map{}["nope"]; } catch (e) { ke_hit = true; ke_type = e.what; }
assert_true(ke_hit, "dict missing key throws");
assert_eq(ke_type, "KeyError", "dict missing key = KeyError");

// KeyError: dot chain middle missing
ke_hit = false;
try {
    var d; d = map{"a": map{}};
    var tmp; tmp = d.a.missing.sub;
} catch (e) { ke_hit = true; ke_type = e.what; }
assert_true(ke_hit, "dot chain middle missing throws");
assert_eq(ke_type, "KeyError", "dot chain middle missing = KeyError");

// ArgError: missing required param
var ae_hit; ae_hit = false;
var ae_type; ae_type = "";
try {
    def f(a) { return a; }
    f();
} catch (e) { ae_hit = true; ae_type = e.what; }
assert_true(ae_hit, "missing arg throws");
assert_eq(ae_type, "ArgError", "missing arg = ArgError");

// ========== String index edge cases ==========
// a string element reads as its byte value (int 0-255), indexed 0 <= i < size
var s; s = "hello";
assert_eq(s[0], 104, "string[0] = byte value");
assert_eq(s[4], 111, "string[4] = byte value");

// string out of bounds
var s_oob_fail; s_oob_fail = false;
try { tmp = s[5]; } catch (e) { s_oob_fail = true; }
assert_true(s_oob_fail, "string[5] OOB throws");

// a byte element writes only from a value the integer conversion takes: a char is not one
var s_write_fail; s_write_fail = false;
try { s[0] = "H"; } catch (e) { s_write_fail = true; }
assert_true(s_write_fail, "string[0] = \"H\" throws");
s[0] = 72;
assert_eq(s[0], 72, "string[0] = 72 writes the byte");

// ========== null index edge cases ==========
// null as non-terminal index should throw IndexError
var null_nonterm_fail; null_nonterm_fail = false;
var nt_type; nt_type = "";
try {
    var a; a = [1, 2, 3];
    tmp = a[null]; // terminal = ok, reads size
    // Actually: a[null].b would be non-terminal. Test with array of dicts.
    var aa; aa = [map{"x": 1}];
    var tmp2; tmp2 = aa[null].x; // Should this work? null here reads size=1, then .x on int... hmm
} catch (e) { null_nonterm_fail = true; nt_type = e.what; }
// This might pass or fail depending on semantics. We'll see.

// ========== Operator type checking (§7.8) ==========
// Bitwise on bool: int-only, throws TypeError
var bbh; bbh = false; var bbt; bbt = "";
try { var tmp; tmp = true & false; } catch (e) { bbh = true; bbt = e.what; }
assert_true(bbh, "true & false throws TypeError");
assert_eq(bbt, "TypeError", "true & false → TypeError ");

// Shift on float: int-only, throws TypeError
var sfh; sfh = false; var sft; sft = "";
try { var tmp; tmp = 1.0 << 2; } catch (e) { sfh = true; sft = e.what; }
assert_true(sfh, "1.0 << 2 throws TypeError");
assert_eq(sft, "TypeError", "1.0 << 2 → TypeError ");

// Compare cross-type: vec vs map
var cmp_vec_map; cmp_vec_map = false;
try { tmp = [1] == map{}; } catch (e) { cmp_vec_map = true; }
assert_true(cmp_vec_map, "vec == map throws TypeError");

// ========== Comparison with null ==========
// null == null → true (doc §7.2)
assert_true(null == null, "null == null");

// null != non-null → true (doc §7.2)
assert_true(null != 0, "null != 0");

// null == non-null → false (doc §7.2: returns false, not error)
if (null == 0 == false) {
    passed = passed + 1;
} else {
    failed = failed + 1;
    failures = failures + "  FAIL null == 0 should be false\n";
}

// null < 0 — DOC BUG §7.2: doc says "null compared against anything → false",
// but ordered comparisons (<, >, <=, >=) with null actually throw TypeError.
// Equality (==, !=) return false per spec.
var null_lt_throws; null_lt_throws = false;
try {
    var result; result = null < 0;
} catch (e) {
    null_lt_throws = true;
    if (e.what == "TypeError") {
        passed = passed + 1;
        // DOC BUG: §7.2 says null<0 → false, code throws TypeError
        // Doc should clarify: ==/!= return false, </>/<=/>= throw TypeError
    } else {
        failed = failed + 1;
        failures = failures + "  FAIL null < 0 threw " + e.what + " not TypeError\n";
    }
}
if (!null_lt_throws) {
    failed = failed + 1;
    failures = failures + "  DOC-BUG §7.2: null < 0 returned " + to_str(result) + " but doc says false; code should throw TypeError\n";
}

// ========== NaN-like edge cases ==========
// 0.0 / 0.0 — should throw DivZeroError
var zero_div_zero_fail; zero_div_zero_fail = false;
try { tmp = 0.0 / 0.0; } catch (e) { zero_div_zero_fail = true; }
assert_true(zero_div_zero_fail, "0.0/0.0 throws DivZeroError");

// ========== vec fill resource limit ==========
// Small fills should work
var sf; sf = [1:10];
assert_eq(sf[null], 10, "small fill works");

// ========== try-catch frame cleanup ==========
// Var declared inside try block must not leak into catch or after
var tc_outer; tc_outer = "outer";
var tc_inner_leak; tc_inner_leak = false;
try {
    var tc_inner; tc_inner = "inner";
    throw "test_cleanup";
} catch (e) {
    // tc_inner should be gone; try to access would be NameError
    try { var dummy; dummy = tc_inner; } catch (e2) { tc_inner_leak = true; }
}
// tc_outer should still be "outer"
assert_eq(tc_outer, "outer", "try-catch: outer var survives after catch");
assert_true(tc_inner_leak, "try-catch: inner var does NOT leak to catch scope");

// Var redeclared after catch must not conflict with try-block var
var tc_redeclare_result; tc_redeclare_result = 0;
try {
    var tc_y; tc_y = "try_scope";
    throw "boom";
} catch (e) {
    tc_redeclare_result = 1;
}
var tc_y; tc_y = "redeclared";
tc_redeclare_result = tc_redeclare_result + 1;
assert_eq(tc_redeclare_result, 2, "try-catch: var redeclare after catch no conflict");
assert_eq(tc_y, "redeclared", "try-catch: redeclared var has correct value");

// Multiple vars inside try block — all must be cleaned
var tc_a; tc_a = "A";
try {
    var tc_b; tc_b = "B";
    var tc_c; tc_c = "C";
    throw "boom";
} catch (e) {}
var tc_b; tc_b = "after";
var tc_c; tc_c = "after";
assert_eq(tc_a + tc_b + tc_c, "Aafterafter", "try-catch: multiple vars cleanup");

// Nested blocks inside try — all block frames cleaned
var tc_nested_result; tc_nested_result = 0;
try {
    if (true) {
        if (true) {
            throw "deep";
        }
    }
} catch (e) {
    tc_nested_result = 1;
}
assert_eq(tc_nested_result, 1, "try-catch: nested blocks inside try");

// Function call inside try that throws — frame cleanup
def tc_thrower() { throw "from_thrower"; }
var tc_func_result; tc_func_result = "none";
try {
    tc_thrower();
} catch (e) {
    tc_func_result = e.info;
}
assert_eq(tc_func_result, "from_thrower", "try-catch: nested func call exception caught");

if (failed > 0) {
    $print("\n=== FAIL: batch5_errors_edges ===\n");
    $print("Passed: %1 / %2\n", passed, passed + failed);
    $print("FAILURES:\n%1", failures);
}

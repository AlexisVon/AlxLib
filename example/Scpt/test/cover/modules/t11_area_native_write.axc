// ====== t11_area_native_write.axc — an area's native table is not a writable slot ======
// link.area.func names a registered function: a script write used to replace the
// registration with the written value, and the call then failed with "Undefined function".
env(["../../bin"]);

link "test_store.so" as ts;
link "base.so" as b;

var passed = 0;
var failed = 0;

def assert_eq(a, b, name) {
    if (a == b) { passed = passed + 1; }
    else { failed = failed + 1; $print("FAIL " + name + ": expected " + string(b) + " got " + string(a)); }
}

def assert_true(c, name) {
    if (c) { passed = passed + 1; }
    else { failed = failed + 1; $print("FAIL " + name + ": expected true"); }
}

// ── direct write ──
{
    var hit; hit = false;
    try { ts.sub.echo = 5; } catch (e) { hit = true; }
    assert_true(hit, "11.1 area native write → refused");
}
{
    var hit; hit = false;
    try { b.mt.abs = 5; } catch (e) { hit = true; }
    assert_true(hit, "11.2 area native write (other link) → refused");
}

// ── compound / @() forms ──
{
    var hit; hit = false;
    try { ts.sub.echo += 1; } catch (e) { hit = true; }
    assert_true(hit, "11.3 area native compound → refused");
}
{
    var hit; hit = false;
    try { @("ts.sub.echo") = 5; } catch (e) { hit = true; }
    assert_true(hit, "11.4 @() area native write → refused");
}

// ── a missing key is not a function either ──
{
    var hit; hit = false;
    try { ts.sub.nope = 5; } catch (e) { hit = true; }
    assert_true(hit, "11.5 missing area key write → refused");
}

// ── the registrations survive: calls and the root-native guard unchanged ──
assert_eq(ts.sub.echo(42), 42, "11.6 area call after the attempts");
assert_eq(b.mt.abs(-5), 5, "11.7 other link's area call");
{
    var hit; hit = false;
    try { ts.set = 5; } catch (e) { hit = true; }
    assert_true(hit, "11.8 link root native write still refused");
}
ts.set("k", 9);
assert_eq(ts.get("k"), 9, "11.9 ts.set/get still work");

$print("--- t11_area_native_write: " + string(passed) + " passed, " + string(failed) + " failed ---");

// TCO: countdown with 50000 depth
def countdown(n) {
  if (n <= 0) {
    return "done";
  }
  return countdown(n - 1);
}
$print(countdown(50000));
$print("\n");

// TCO: tail-recursive fib
def fib_tail(n, a=0, b=1) {
  if (n == 0) {
    return a;
  }
  if (n == 1) {
    return b;
  }
  return fib_tail(n - 1, b, a + b);
}
$print(fib_tail(20));
$print("\n");
